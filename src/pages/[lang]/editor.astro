---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { canPublish, canReview, editorIdentity } from '../../lib/admin-auth';
import type { Language } from '../../lib/types';
const lang = Astro.params.lang as Language;
if (lang !== 'es' && lang !== 'en') return Astro.redirect('/es/', 302);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const identity = await editorIdentity(Astro.request);
const authorized = Boolean(identity);
const resources = authorized ? (await env.DB.prepare('SELECT slug,name,kind,status,updated_at FROM resources ORDER BY updated_at DESC LIMIT 30').all<{slug:string;name:string;kind:string;status:string;updated_at:string}>()).results : [];
const submissions = canReview(identity) ? (await env.DB.prepare("SELECT * FROM submissions WHERE status='pending' ORDER BY submitted_at DESC LIMIT 50").all<{id:string;name:string;url:string;kind:string;note:string;submitted_at:string;proposal_type:string;source_locator:string;interest:string;credit_choice:string;credit_name:string;ai_assisted:number}>()).results : [];
const events = canReview(identity) ? (await env.DB.prepare("SELECT e.*,s.name AS source_name FROM monitoring_events e JOIN monitored_sources s ON s.id=e.source_id WHERE e.status='pending' ORDER BY e.detected_at DESC LIMIT 30").all<{id:string;detail:string;kind:string;source_name:string;detected_at:string}>()).results : [];
---
<Base lang={lang} title={lang==='es'?'Edición':'Editor'}>
  <header class="article-head"><p class="eyebrow">Cyberdeception Atlas</p><h1>{lang==='es'?'Gestión editorial':'Editorial management'}</h1><p>{lang==='es'?'Las propuestas y cambios de fuentes requieren revisión antes de publicarse.':'Submissions and source changes require review before publication.'}</p></header>
  {!authorized ? <form class="editor-login" action="/api/admin/login" method="post"><label for="secret">{lang==='es'?'Clave de edición':'Editor key'}</label><input id="secret" name="secret" type="password" required autocomplete="current-password"/><button class="button" type="submit">{lang==='es'?'Ingresar':'Sign in'}</button>{Astro.url.searchParams.has('error') && <p>{lang==='es'?'Clave incorrecta.':'Incorrect key.'}</p>}</form> : <>
    <form action="/api/admin/logout" method="post"><button class="button secondary small">{lang==='es'?'Salir':'Sign out'}</button></form>
    {canReview(identity) && <section class="editor-section"><h2>{lang==='es'?'Propuestas pendientes':'Pending submissions'} ({submissions.length})</h2>{submissions.map(item=><div class="editor-row"><div><strong>{item.name}</strong><small>{item.proposal_type} · {item.kind} · {item.submitted_at}</small><a href={item.url} target="_blank" rel="noopener noreferrer">{item.url}</a><p>{item.note}</p><p>{lang==='es'?'Localizador':'Locator'}: {item.source_locator || '—'}</p><p>{lang==='es'?'Interés':'Interest'}: {item.interest || '—'}</p><p>{lang==='es'?'Crédito':'Credit'}: {item.credit_choice}{item.credit_name ? ` (${item.credit_name})` : ''} · IA: {item.ai_assisted ? 'sí' : 'no'}</p></div><form action="/api/admin/submission" method="post"><input type="hidden" name="id" value={item.id}/><label>{lang==='es'?'Motivo de la decisión':'Decision reason'}<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button class="button secondary small" name="decision" value="accepted">{lang==='es'?'Aceptar para curar':'Accept for curation'}</button><button class="button secondary small" name="decision" value="rejected">{lang==='es'?'Rechazar':'Reject'}</button></form></div>)}{submissions.length===0&&<p>{lang==='es'?'Sin propuestas pendientes.':'No pending submissions.'}</p>}</section>}
    {canReview(identity) && <section class="editor-section"><h2>{lang==='es'?'Crear ficha':'Create record'}</h2><p>{lang==='es'?'Ingresá una fuente primaria verificada. La ficha se guarda como borrador hasta decidir publicarla.':'Enter a verified primary source. The record remains a draft until publication.'}</p><form action="/api/admin/resource" method="post" class="editor-form"><input name="name" placeholder="Name" required maxlength="120"/><select name="kind"><option value="software">Software</option><option value="paper">Paper</option><option value="product">Product</option><option value="service">Service</option><option value="case-study">Case study</option><option value="dataset">Dataset</option><option value="framework">Framework</option><option value="community">Community</option></select><input name="source_url" type="url" placeholder="https://..." required/><textarea name="summary_es" placeholder="Resumen español" required></textarea><textarea name="summary_en" placeholder="English summary" required></textarea><input name="organization" placeholder="Organization"/><input name="year" type="number" min="1900" max="2100" placeholder="Year"/><button class="button">{lang==='es'?'Guardar borrador':'Save draft'}</button></form></section>}
    <section class="editor-section"><h2>{lang==='es'?'Fichas recientes':'Recent records'}</h2>{resources.map(item=><div class="editor-row"><div><strong>{item.name}</strong><small>{item.kind} · {item.status} · {item.updated_at}</small>{canReview(identity) && <a href={`/${lang}/editor/${item.slug}`}>{lang==='es'?'Editar ficha':'Edit record'}</a>}</div>{canPublish(identity) && <form action="/api/admin/resource-status" method="post"><input type="hidden" name="slug" value={item.slug}/><label>{lang==='es'?'Motivo':'Reason'}<textarea name="reason" required minlength="10" maxlength="1000"></textarea></label><button class="button secondary small" name="status" value="published">{lang==='es'?'Publicar':'Publish'}</button><button class="button secondary small" name="status" value="archived">{lang==='es'?'Archivar':'Archive'}</button></form>}</div>)}</section>
    {canReview(identity) && <section class="editor-section"><h2>{lang==='es'?'Cambios detectados':'Detected changes'}</h2>{events.map(item=><div class="editor-row"><div><strong>{item.source_name}</strong><small>{item.kind} · {item.detected_at}</small><p>{item.detail}</p></div><form action="/api/admin/event" method="post"><input name="id" type="hidden" value={item.id}/><button class="button secondary small">{lang==='es'?'Marcar revisado':'Mark reviewed'}</button></form></div>)}{events.length===0&&<p>{lang==='es'?'Sin cambios pendientes.':'No pending changes.'}</p>}</section>}
  </>}
</Base>
