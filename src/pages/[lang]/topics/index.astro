---
import Base from '../../../layouts/Base.astro';
import { topics } from '../../../lib/topics';
import type { Language } from '../../../lib/types';
const lang=Astro.params.lang as Language;
if(lang!=='es'&&lang!=='en')return Astro.redirect('/es/',302);
---
<Base lang={lang} title={lang==='es'?'Empezá por un problema de detección':'Start with a detection problem'}>
  <header class="article-head reference-head"><p class="eyebrow">{lang==='es'?'Explorar / Preguntas defensivas':'Explore / Defensive questions'}</p><h1>{lang==='es'?'¿Qué comportamiento querés detectar?':'What behavior do you want to detect?'}</h1><p>{lang==='es'?'Empezá por una acción inesperada. Después explorá la técnica, el entorno y las fuentes que pueden orientar una prueba.':'Start with an unexpected action. Then explore the technique, environment and sources that can inform a test.'}</p></header>
  <section class="reference-section"><div class="section-heading"><p class="eyebrow">01 / {lang==='es'?'Preguntas frecuentes':'Common questions'}</p><h2>{lang==='es'?'Tres puntos de partida':'Three starting points'}</h2></div><div class="evidence-lanes"><a href={`/${lang}/topics/honeytokens`}><small>{lang==='es'?'IDENTIDAD':'IDENTITY'}</small><strong>{lang==='es'?'Uso de una credencial señuelo':'Use of a decoy credential'}</strong><span>{lang==='es'?'¿Qué uso debería generar una alerta y cómo descartar actividad legítima?':'What use should trigger an alert, and how do you rule out legitimate activity?'}</span><b aria-hidden="true">↗</b></a><a href={`/${lang}/topics/honeypots`}><small>{lang==='es'?'RED':'NETWORK'}</small><strong>{lang==='es'?'Exploración de un servicio interno':'Reconnaissance of an internal service'}</strong><span>{lang==='es'?'¿Qué interacción sería inesperada y qué información necesitaría la respuesta?':'What interaction would be unexpected, and what would responders need to know?'}</span><b aria-hidden="true">↗</b></a><a href={`/${lang}/topics/decoys`}><small>{lang==='es'?'ACTIVOS':'ASSETS'}</small><strong>{lang==='es'?'Acceso a un activo señuelo':'Access to a decoy asset'}</strong><span>{lang==='es'?'¿Dónde ubicarlo y qué riesgo introduce para el entorno real?':'Where should it be placed, and what risk does it introduce to the real environment?'}</span><b aria-hidden="true">↗</b></a></div></section>
  <section class="foundation-strip"><div><p class="eyebrow">{lang==='es'?'Vocabulario de referencia':'Reference vocabulary'}</p><h2>{lang==='es'?'Poné nombre a la técnica':'Name the technique'}</h2><p>{lang==='es'?'MITRE Engage ayuda a planificar operaciones de engaño e interacción; D3FEND describe objetos y entornos señuelo. El glosario del Atlas explica las etiquetas usadas aquí.':'MITRE Engage helps plan deception and engagement operations; D3FEND describes decoy objects and environments. The Atlas glossary explains the labels used here.'}</p></div><div><a href={`/${lang}/methodology`}>{lang==='es'?'Glosario y método':'Glossary and method'} →</a><a href={`/${lang}/resource/mitre-engage`}>MITRE Engage →</a><a href={`/${lang}/resource/mitre-d3fend`}>MITRE D3FEND →</a></div></section>
  <div class="reference-two-column"><section><p class="eyebrow">02 / {lang==='es'?'Técnicas':'Techniques'}</p><h2 class="section-title">{lang==='es'?'Qué hace el señuelo':'What the lure does'}</h2><div class="topic-directory">{topics.filter(topic=>topic.group==='technique').map((topic,i)=><a href={`/${lang}/topics/${topic.slug}`}><small>{String(i+1).padStart(2,'0')} / {topic.label}</small><strong>{lang==='es'?topic.title_es:topic.title_en}</strong><span>{lang==='es'?topic.description_es:topic.description_en}</span><b aria-hidden="true">↗</b></a>)}</div></section><section><p class="eyebrow">03 / {lang==='es'?'Entornos':'Environments'}</p><h2 class="section-title">{lang==='es'?'Dónde se sitúa':'Where it is placed'}</h2><div class="topic-directory">{topics.filter(topic=>topic.group==='environment').map((topic,i)=><a href={`/${lang}/topics/${topic.slug}`}><small>{String(i+1).padStart(2,'0')} / {topic.label}</small><strong>{lang==='es'?topic.title_es:topic.title_en}</strong><span>{lang==='es'?topic.description_es:topic.description_en}</span><b aria-hidden="true">↗</b></a>)}</div></section></div>
  <p class="note">{lang==='es'?'Esta taxonomía orienta la navegación. MITRE D3FEND y Engage aportan vocabulario de referencia; las etiquetas del Atlas son decisiones editoriales y no equivalen a una clasificación oficial de MITRE.':'This taxonomy guides navigation. MITRE D3FEND and Engage provide reference terminology; Atlas labels are editorial choices and are not an official MITRE classification.'}</p>
</Base>
