---
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import ResourceCard from '../../../components/ResourceCard.astro';
import { browseResources, topicKindCounts } from '../../../lib/catalog';
import { topicBySlug } from '../../../lib/topics';
import type { Language } from '../../../lib/types';
const lang=Astro.params.lang as Language;
if(lang!=='es'&&lang!=='en')return Astro.redirect('/es/',302);
const topic=topicBySlug[Astro.params.slug??''];
if(!topic)return new Response(lang==='es'?'Tema no encontrado':'Topic not found',{status:404});
const [results,kinds]=await Promise.all([
  browseResources(env.DB,topic.group==='technique'?{technique:topic.label,limit:6}:{environment:topic.label,limit:6}),
  topicKindCounts(env.DB,topic.group,topic.label)
]);
const title=lang==='es'?topic.title_es:topic.title_en;
const description=lang==='es'?topic.description_es:topic.description_en;
---
<Base lang={lang} title={title} description={description}>
  <header class="article-head reference-head"><p class="breadcrumb"><a href={`/${lang}/topics`}>{lang==='es'?'Mapa de temas':'Topic map'}</a> / {topic.group==='technique'?(lang==='es'?'Técnica':'Technique'):(lang==='es'?'Entorno':'Environment')}</p><p class="eyebrow">{topic.group==='technique'?(lang==='es'?'Técnica defensiva':'Defensive technique'):(lang==='es'?'Superficie de aplicación':'Deployment environment')}</p><h1>{title}</h1><p>{description}</p></header>
  <div class="topic-detail-grid"><article><section class="topic-question"><p class="eyebrow">{lang==='es'?'Pregunta de investigación':'Research question'}</p><h2>{lang==='es'?topic.question_es:topic.question_en}</h2></section><section class="topic-reading"><h2 class="section-title">{lang==='es'?'Contexto y método':'Context and method'}</h2><p>{lang==='es'?'La definición y las consideraciones técnicas deben contrastarse con la fuente primaria. Las fichas del Atlas registran una selección de recursos etiquetados con este tema; una coincidencia de etiqueta no demuestra resultados operativos.':'Definitions and technical considerations should be checked against the primary source. Atlas records are a selection tagged with this topic; a matching tag does not demonstrate operational outcomes.'}</p><div class="topic-actions"><a class="button secondary" href={topic.sourceUrl} target="_blank" rel="noopener noreferrer">{topic.sourceLabel} ↗</a><a class="button secondary" href={`/${lang}/research/${topic.guide}`}>{lang==='es'?'Guía relacionada':'Related guide'} ↗</a></div></section></article><aside class="topic-side"><p class="eyebrow">{lang==='es'?'Cruces de navegación':'Navigation cross-links'}</p><h3>{lang==='es'?'Seguí investigando':'Keep exploring'}</h3><a href={`/${lang}/evidence`}>{lang==='es'?'Evidencia y experiencias':'Evidence and field reports'} →</a><a href={`/${lang}/solutions`}>{lang==='es'?'Productos, servicios y software':'Products, services and software'} →</a><a href={`/${lang}/methodology`}>{lang==='es'?'Cómo se revisan las fuentes':'How sources are reviewed'} →</a></aside></div>
  <section class="topic-crosswalk"><div class="section-heading"><p class="eyebrow">{lang==='es'?'Cruce de tipos':'Cross-reference'}</p><h2>{lang==='es'?'Este tema en distintas fuentes':'This topic across source types'}</h2><p>{lang==='es'?'Estas cifras representan fichas etiquetadas en el Atlas, no la cantidad mundial de trabajos u ofertas.':'These counts describe tagged Atlas records, not the worldwide number of studies or offerings.'}</p></div><div class="topic-count-grid"><a href={`/${lang}/library?${topic.libraryFilter}&kind=paper`}><strong>{kinds.paper??0}</strong><span>{lang==='es'?'papers':'papers'}</span></a><a href={`/${lang}/library?${topic.libraryFilter}&kind=dataset`}><strong>{kinds.dataset??0}</strong><span>{lang==='es'?'datasets':'datasets'}</span></a><a href={`/${lang}/library?${topic.libraryFilter}&kind=case-study`}><strong>{kinds['case-study']??0}</strong><span>{lang==='es'?'experiencias':'field reports'}</span></a><a href={`/${lang}/library?${topic.libraryFilter}&kind=product`}><strong>{kinds.product??0}</strong><span>{lang==='es'?'productos':'products'}</span></a><a href={`/${lang}/library?${topic.libraryFilter}&kind=service`}><strong>{kinds.service??0}</strong><span>{lang==='es'?'servicios':'services'}</span></a><a href={`/${lang}/library?${topic.libraryFilter}&kind=software`}><strong>{kinds.software??0}</strong><span>{lang==='es'?'software abierto':'open software'}</span></a></div></section>
  <section><div class="section-heading section-heading-inline"><div><p class="eyebrow">{lang==='es'?'Biblioteca enlazada':'Linked library'}</p><h2 class="section-title">{lang==='es'?'Fichas asociadas':'Associated records'}</h2></div><span>{results.total} {lang==='es'?'fichas etiquetadas':'tagged records'}</span></div>{results.items.length>0?<div class="resource-grid">{results.items.map(resource=><ResourceCard resource={resource} lang={lang}/>)}</div>:<p class="empty">{lang==='es'?'Aún no hay fichas verificadas con esta etiqueta.':'No verified records carry this tag yet.'}</p>}<div class="topic-more"><a class="button" href={`/${lang}/library?${topic.libraryFilter}`}>{lang==='es'?'Ver todas las fichas del tema':'See all records for this topic'} →</a></div></section>
</Base>
