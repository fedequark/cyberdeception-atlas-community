---
import Base from '../../layouts/Base.astro';
import { copy } from '../../lib/i18n';
import type { Language } from '../../lib/types';
export const prerender = true;
export function getStaticPaths(){return ['es','en'].map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Language;if(lang!=='es'&&lang!=='en')return Astro.redirect('/es/',302);const t=copy[lang];
const glossary=[
  ['Honeypot','Sistema o servicio señuelo que registra interacciones no autorizadas.','Decoy system or service recording unauthorized interactions.'],
  ['Honeytoken','Dato señuelo que alerta cuando alguien lo consulta o usa.','Decoy data that triggers an alert when accessed or used.'],
  ['Decoy','Activo que representa un recurso real para desviar u observar acciones.','Asset resembling a real resource to divert or observe activity.'],
  ['Adversary engagement','Actividades defensivas planificadas para observar e influir en un adversario.','Planned defensive activities to observe and influence an adversary.'],
  ['Moving target defense','Cambio deliberado de características del entorno para dificultar el reconocimiento; se etiqueta como área relacionada cuando corresponde.','Deliberate change to environment characteristics that makes reconnaissance harder; labeled as a related area when applicable.'],
];
---
<Base lang={lang} title={t.methods}><header class="article-head"><p class="eyebrow">{t.methods}</p><h1>{lang==='es'?'Qué podés comprobar en el Atlas':'What you can check in Atlas'}</h1><p>{lang==='es'?'Mostramos la fuente, el material examinado y los datos que todavía faltan. Así podés distinguir una opción documentada de un resultado medido.':'We show the source, what was reviewed and what remains unknown. This helps distinguish a documented option from a measured outcome.'}</p></header>
  <div class="detail-grid"><article class="prose">
    <h2>{lang==='es'?'Alcance':'Scope'}</h2><p>{lang==='es'?'Incluimos recursos públicos relevantes para la defensa mediante señuelos, engaño y observación del adversario. Etiquetamos por separado áreas relacionadas, como moving target defense. Mostramos fecha y material revisado; el idioma de la fuente se registra cuando está verificado.':'We include public resources relevant to defensive decoys, deception and adversary observation. Related areas such as moving target defense are labeled separately. We show review dates and the material examined; source language is recorded when verified.'}</p>
    <h2>{lang==='es'?'Cómo entra un recurso':'How a resource is added'}</h2><ol><li>{lang==='es'?'Identificamos la fuente original y comprobamos su URL, autoría y fecha.':'We identify the original source and check its URL, authorship and date.'}</li><li>{lang==='es'?'Clasificamos técnica, entorno y tipo de recurso.':'We classify technique, environment and resource kind.'}</li><li>{lang==='es'?'Escribimos un resumen propio que no afirma más de lo que permite la fuente.':'We write an original summary bounded by the source.'}</li><li>{lang==='es'?'Registramos si leímos una página comercial, documentación de repositorio, metadatos de publicación, abstract o texto completo.':'We record whether we read a product page, repository documentation, publisher metadata, abstract or full text.'}</li><li>{lang==='es'?'Un editor revisa los cambios antes de publicar.':'An editor reviews changes before publication.'}</li></ol>
    <h2>{lang==='es'?'Qué material revisamos':'What we reviewed'}</h2><p>{lang==='es'?'Distinguimos página pública, metadatos de repositorio, metadatos editoriales, abstract y texto completo. Esa clasificación describe el material examinado, no la calidad de un producto. Cada afirmación debe mantenerse dentro de lo que permite su fuente. Las notas de lectura crítica explican límites y preguntas abiertas; no representan pruebas independientes.':'We distinguish public pages, repository metadata, publisher metadata, abstracts and full text. These categories describe what was examined, not product quality. Every claim must stay within its source. Critical-reading notes explain limits and open questions; they are not independent tests.'}</p>
    <h2>{lang==='es'?'Cobertura y datos faltantes':'Coverage and missing data'}</h2><p>{lang==='es'?'El mapa muestra la distribución editorial por tipo de recurso, técnica, entorno y profundidad de revisión. El país de la organización se registra para productos y servicios cuando la fuente lo respalda; el idioma de la fuente, cuando está verificado. No inferimos cobertura de despliegue ni sectores de adopción a partir de la sede de un proveedor o del tema de una publicación. Una celda vacía indica falta de evidencia catalogada, no ausencia de oferta o investigación.':'The map shows the editorial distribution by resource type, technique, environment and review depth. Organization country is recorded for products and services when supported by the source; source language when verified. We do not infer deployment coverage or adoption sectors from a vendor location or publication topic. An empty cell means no catalogued evidence, not an absence of offerings or research.'}</p><p><a href={`/${lang}/coverage`}>{lang==='es'?'Ver mapa y datos faltantes':'See the map and missing data'} →</a></p>
    <h2>{lang==='es'?'Comparación':'Comparison'}</h2><p>{lang==='es'?'No ordenamos productos por eficacia a partir de páginas comerciales. Una comparación debe registrar el mismo escenario, baseline, señales investigables, casos sin alerta, falsos positivos y carga operativa. Publicamos el protocolo y una plantilla reutilizable.':'We do not rank products by effectiveness from commercial pages. A comparison records the same scenario, baseline, investigable signals, missed alerts, false positives and operating load. We publish the protocol and a reusable template.'}</p><p><a href={`/${lang}/research/protocol`}>{lang==='es'?'Leer protocolo':'Read the protocol'} →</a></p>
    <h2>{lang==='es'?'Correcciones e intereses':'Corrections and interests'}</h2><p>{lang==='es'?'Aceptamos propuestas y correcciones con URL primaria. Un aporte de proveedor se atribuye como tal y no obtiene trato preferente. El editor comprueba fuente, alcance y posible conflicto de intereses antes de publicar. Federico Pacheco, responsable del Atlas, participa en BUDA, DOLOS-T y Cyber Deception Playground; esas seis fichas tienen una declaración visible y no se presentan como evaluaciones independientes. Una corrección cambia la ficha mediante revisión editorial; una detección automática solo crea un recordatorio.':'We accept suggestions and corrections with a primary URL. Vendor submissions are attributed and receive no preferential treatment. The editor checks source, scope and potential conflicts before publication. Federico Pacheco, the Atlas owner, contributed to BUDA, DOLOS-T and Cyber Deception Playground; those six records carry a visible disclosure and are not presented as independent evaluations. A correction changes a record through editorial review; automated discovery only creates a reminder.'}</p><p><a href={`/${lang}/contribute`}>{lang==='es'?'Proponer corrección':'Suggest a correction'} →</a></p>
    <h2>{lang==='es'?'Límites':'Limits'}</h2><p>{lang==='es'?'La cobertura crece por etapas. Una ficha basada en metadatos no equivale a un análisis completo de un paper. Una experiencia publicada por un proveedor conserva esa atribución. Los campos sin evidencia pública permanecen vacíos. El catálogo no pretende ser un censo mundial.':'Coverage grows in stages. A metadata-only record is not a full paper analysis. Vendor-published experiences retain that attribution. Fields without public evidence remain empty. The catalog is not a worldwide census.'}</p>
    <h2>{lang==='es'?'Glosario':'Glossary'}</h2><div class="glossary">{glossary.map(([term,es,en])=><div><strong>{term}</strong><p>{lang==='es'?es:en}</p></div>)}</div>
  </article><aside class="metadata"><h2 style="margin-top:0">{lang==='es'?'Bases iniciales':'Starting references'}</h2><ul class="source-list"><li><a href="https://github.com/mitre/engage">MITRE Engage</a></li><li><a href="https://arxiv.org/abs/2409.07194">CYDEC survey</a></li><li><a href="https://www.ncsc.gov.uk/blog-post/cyber-deception-trials-what-weve-learned-so-far">NCSC trials</a></li></ul><p class="small-muted">{lang==='es'?'Última revisión editorial: 2026-10-02.':'Last editorial review: 2026-10-02.'}</p></aside></div>
</Base>
